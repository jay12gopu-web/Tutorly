NODE_ENV=development
PORT=3001
APP_ORIGIN=https://mytutor.co.in
TUTORLY_ALLOWED_ORIGINS=https://mytutor.co.in,http://127.0.0.1:3001,http://127.0.0.1:8000,http://127.0.0.1:8765

# Razorpay Test Mode keys
RAZORPAY_KEY_ID=rzp_test_replace_me
RAZORPAY_SECRET=replace_me
RAZORPAY_WEBHOOK_SECRET=replace_me

# MongoDB connection
MONGODB_URI=mongodb://127.0.0.1:27017/tutorly

# AI chatbot backend (copy these only into backend/.env or deployment secrets)
GROQ_API_KEY=
TUTORLY_GROQ_MODEL=openai/gpt-oss-120b

# Optional live search providers.
# Selection priority when multiple keys exist:
# Tavily -> Brave Search -> Google Custom Search -> Bing Search.
TUTORLY_SEARCH_PROVIDER=
TUTORLY_SEARCH_RETRIES=2
TUTORLY_SEARCH_CACHE_SECONDS=900
TAVILY_API_KEY=
BRAVE_SEARCH_API_KEY=
GOOGLE_SEARCH_API_KEY=
GOOGLE_SEARCH_ENGINE_ID=
BING_SEARCH_API_KEY=
