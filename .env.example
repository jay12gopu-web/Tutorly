NODE_ENV=development
PORT=3001
APP_ORIGIN=https://mytutor.co.in
TUTORLY_ALLOWED_ORIGINS=https://mytutor.co.in,http://127.0.0.1:3001,http://127.0.0.1:8000,http://127.0.0.1:8765
TUTORLY_FRONTEND_ORIGIN=https://mytutor.co.in

# Social authentication (backend/deployment secrets only)
# Register these exact callbacks with each provider:
# https://tutorly-api.onrender.com/api/auth/oauth/google/callback
# https://tutorly-api.onrender.com/api/auth/oauth/microsoft/callback
# https://tutorly-api.onrender.com/api/auth/oauth/apple/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://tutorly-api.onrender.com/api/auth/oauth/google/callback

MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_REDIRECT_URI=https://tutorly-api.onrender.com/api/auth/oauth/microsoft/callback
MICROSOFT_TENANT=common

APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
# Store the complete .p8 key as a multiline secret or with literal \\n characters.
APPLE_PRIVATE_KEY=
APPLE_REDIRECT_URI=https://tutorly-api.onrender.com/api/auth/oauth/apple/callback

# Razorpay Test Mode keys
RAZORPAY_KEY_ID=rzp_test_replace_me
RAZORPAY_SECRET=replace_me
RAZORPAY_WEBHOOK_SECRET=replace_me

# MongoDB connection
MONGODB_URI=mongodb://127.0.0.1:27017/tutorly

# AI chatbot backend (copy these only into backend/.env or deployment secrets)
GROQ_API_KEY=
TUTORLY_GROQ_MODEL=openai/gpt-oss-120b
# Optional override for server-side Voice Chat transcription.
TUTORLY_GROQ_TRANSCRIPTION_MODEL=whisper-large-v3-turbo

# ElevenLabs full Voice Chat (backend/deployment secrets only)
# The API key is exchanged server-side for a short-lived WebRTC token.
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=agent_0201m0wydx9bft0tn09q0ex0ghm0
ELEVENLABS_ENVIRONMENT=production

# Optional live search providers.
# Selection priority when multiple keys exist:
# Tavily -> Brave Search -> Google Custom Search -> Bing Search.
TUTORLY_SEARCH_PROVIDER=
TUTORLY_SEARCH_RETRIES=2
TUTORLY_SEARCH_CACHE_SECONDS=900
TAVILY_API_KEY=
BRAVE_SEARCH_API_KEY=
GOOGLE_SEARCH_API_KEY=
GOOGLE_SEARCH_ENGINE_ID=
BING_SEARCH_API_KEY=
