GROQ_API_KEY=

# Dedicated OpenAI image key: never set in frontend code.
OPENAI_IMAGE_API_KEY=
TUTORLY_IMAGE_MODEL=gpt-image-1-mini
# Explicit development mode permits OPENAI_API_KEY fallback only on local hosts.
TUTORLY_ENV=production
# URL of the existing Node payment service; HTTPS in production.
TUTORLY_CREDIT_SERVICE_URL=
# Same random 32+ character server-only secret on Python and Node services.
TUTORLY_CREDIT_SERVICE_SECRET=

# Sarvam Vision homework-image OCR. Keep this key on the backend only.
SARVAM_API_KEY=

# ElevenLabs is used only by the backend to issue short-lived WebRTC tokens.
# Agent IDs live in shared/tutorly-voice-agents.json; never place this key in frontend code.
ELEVENLABS_API_KEY=

# Shared PostgreSQL used only for anonymous operational telemetry.
DATABASE_URL=

# Comma-separated Tutorly account emails allowed to assert the admin role.
# Keep this backend-only even though it is not a password.
TUTORLY_ADMIN_EMAILS=

# Tutorly email login with Gmail SMTP.
# Use a Google App Password, never the normal Gmail account password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-address@gmail.com
SMTP_PASSWORD=your-16-character-google-app-password
SMTP_FROM_EMAIL=your-address@gmail.com
SMTP_USE_SSL=false

# Generate a long random value (at least 24 characters). Never expose it to the browser.
TUTORLY_OTP_SECRET=

TUTORLY_ALLOWED_ORIGINS=https://mytutor.co.in,http://127.0.0.1:8000,http://127.0.0.1:8769
