GROQ_API_KEY=

# Sarvam Vision homework-image OCR. Keep this key on the backend only.
SARVAM_API_KEY=

# ElevenLabs is used only by the backend to issue short-lived WebRTC tokens.
# Agent IDs live in shared/tutorly-voice-agents.json; never place this key in frontend code.
ELEVENLABS_API_KEY=

# Tutorly email login with Gmail SMTP.
# Use a Google App Password, never the normal Gmail account password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-address@gmail.com
SMTP_PASSWORD=your-16-character-google-app-password
SMTP_FROM_EMAIL=your-address@gmail.com
SMTP_USE_SSL=false

# Generate a long random value (at least 24 characters). Never expose it to the browser.
TUTORLY_OTP_SECRET=

TUTORLY_ALLOWED_ORIGINS=https://mytutor.co.in,http://127.0.0.1:8000,http://127.0.0.1:8769
